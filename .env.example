# Toigo — settings for Cloudflare Workers. Never put real values in this file or in git.
#
# Plain settings live in wrangler.toml [vars]:
#   SITE_URL, PAYMENT_MODE (manual|finik), FINIK_ENV (beta|prod), ADMIN_EMAIL, MAIL_FROM
# The database is the D1 binding "DB" in wrangler.toml (no connection string needed).
#
# Secrets are set once per secret:   npx wrangler secret put NAME
# (or Cloudflare dashboard → Workers → toigo-app → Settings → Variables and Secrets → Add → Secret).
# For local `wrangler dev`, put them in .dev.vars (git-ignored), same format as below.

# --- Admin panel (/admin/) ---
# Make it with:  node tools/admin-hash.mjs 'a long password'
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# --- Finik online payments (only when PAYMENT_MODE = "finik") ---
# API key from Finik
FINIK_API_KEY=
# Your Finik account id (Data.accountId)
FINIK_ACCOUNT_ID=
# Your RSA private key (PEM, the whole text incl. BEGIN/END lines). Its public half goes to Finik.
FINIK_PRIVATE_KEY=
# Finik's public key for webhooks — different for beta and prod, take it from Finik's documentation
FINIK_PUBLIC_KEY=

# --- E-mail (optional alternative to the Cloudflare send_email binding) ---
# Resend API key, only if you use resend.com instead of Cloudflare Email Routing
RESEND_API_KEY=

# --- Local development only ---
# SITE_URL=http://127.0.0.1:8787
